# ═══════════════════════════════════════════════════════════════════════
#  Token GHI của Proxmox (dựng/xoá VM). KHÁC token chỉ đọc ở .env.pve.
#
#  Cách dùng: cp .env.pve.deploy.example .env.pve.deploy, điền secret,
#  chmod 600 .env.pve.deploy. File thật bị .gitignore (quy tắc .env.*),
#  KHÔNG commit, KHÔNG dán vào chat. Chỉ người hoặc pipeline có duyệt dùng.
#
#  Token tạo ở docs/PROXMOX_DEPLOY.md mục 2.2 (quyền giới hạn trong pool
#  ai-assistant, KHÔNG phải root@pam).
# ═══════════════════════════════════════════════════════════════════════
PVE_HOST=192.168.100.252
PVE_PORT=8006
PVE_NODE=isec

# Định dạng <user>@<realm>!<tên token>
PVE_TOKEN_ID=deploy@pve!automation
PVE_TOKEN_SECRET=

# Fingerprint TLS đã ghim (đổi nếu cài lại Proxmox), giống .env.pve.
PVE_TLS_FINGERPRINT=A3:33:33:B3:90:3C:34:10:88:85:25:3B:1B:19:61:1B:EB:71:72:61:D0:7A:1C:09:85:F7:30:EE:8C:D2:12:AE

# Thông số dựng VM
PVE_STORAGE=local-lvm
PVE_TEMPLATE_ID=9000
PVE_POOL=ai-assistant
PVE_GATEWAY=192.168.100.1
PVE_DNS=192.168.100.1
