# ═══════════════════════════════════════════════════════════════════════
#  Thông tin kết nối Proxmox cho các script trong infra/proxmox/.
#
#  Cách dùng: cp .env.pve.example .env.pve rồi điền PVE_TOKEN_SECRET.
#  .env.pve đã bị .gitignore (quy tắc .env.*), KHÔNG commit, KHÔNG dán vào chat.
# ═══════════════════════════════════════════════════════════════════════

# Địa chỉ node Proxmox (cổng 8006 là web/API).
PVE_HOST=192.168.100.252
PVE_PORT=8006

# Token chỉ đọc (role PVEAuditor), dùng cho `make pve-check`. Không tạo/xoá được gì.
# Tạo bằng: pveum user token add readonly@pve audit --privsep 1
PVE_TOKEN_ID=readonly@pve!audit
PVE_TOKEN_SECRET=

# Fingerprint chứng chỉ TLS tự ký, để ghim thay vì tắt kiểm tra chứng chỉ.
# Giá trị đã đo ngày 2026-10-09; đổi nếu cài lại Proxmox.
PVE_TLS_FINGERPRINT=A3:33:33:B3:90:3C:34:10:88:85:25:3B:1B:19:61:1B:EB:71:72:61:D0:7A:1C:09:85:F7:30:EE:8C:D2:12:AE
