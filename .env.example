# ═══════════════════════════════════════════════════════════════
#  Builder AI Assistant — biến môi trường
#  Copy sang .env rồi điền giá trị thật. KHÔNG commit file .env.
#  Nguồn đối chiếu: docker-compose*.yml, apps/core/app/core/config.py,
#  apps/web (process.env.*), scripts/smoke-test.sh.
#  Ký hiệu: [BẮT BUỘC] thiếu thì stack không lên · [TUỲ CHỌN] có mặc định.
# ═══════════════════════════════════════════════════════════════

# ── Chung ──────────────────────────────────────────────────────
# Múi giờ hiển thị, dùng chung cho web và core (core đọc DISPLAY_TIMEZONE
# trước, rồi TZ). Phải là tên IANA hợp lệ, sai thì core không khởi động.
# DB luôn lưu UTC.
TZ=Asia/Ho_Chi_Minh

# Giá trị hợp lệ: development | staging | production
# UAT dùng "staging". Đặt "uat" sẽ làm app không khởi động được vì
# config.py validate bằng Literal. Xem docs/git-workflow.md.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Tiền tố cho tên container, volume và network. BẮT BUỘC đặt khác nhau nếu
# UAT và production chạy trên cùng một node, nếu không hai stack dùng chung
# volume và tranh nhau. Ví dụ: builder-uat, builder-prod.
# (Worktree task tự sinh builder-t<N> qua .env.worktree, không sửa ở đây.)
COMPOSE_PROJECT_NAME=builder-dev

# Tag image khi chạy docker-compose.prod.yml. "local" = build tại chỗ
# (make prod-build). CI/deploy đặt sha-<7 ký tự> để kéo đúng image từ GHCR.
IMAGE_TAG=local

# ── Postgres ───────────────────────────────────────────────────
# DATABASE_URL của core được compose tự ghép từ 3 biến này.
POSTGRES_USER=builder
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=builder_ai
POSTGRES_PORT=5432

# ── Redis ──────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Core API (FastAPI) ─────────────────────────────────────────
API_PORT=8000
# [BẮT BUỘC] Khoá header X-API-Key, tối thiểu 16 ký tự. Chỉ nằm ở server env,
# không bao giờ chạm browser.
# Sinh khoá: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY

# [BẮT BUỘC] Khoá ký JWT HS256 web -> core (sống 60 giây), tối thiểu 32 ký tự.
# PHẢI khác API_KEY và khác AUTH_SECRET. Web và core dùng CÙNG giá trị.
# Thiếu thì core không khởi động (fail closed).
# Sinh khoá: python -c "import secrets; print(secrets.token_urlsafe(48))"
CORE_JWT_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_RANDOM_KEY_32_CHARS_MIN

CORS_ORIGINS=http://localhost:3000

# Khoá Fernet mã hoá token tích hợp (Jira...) khi lưu DB. KHÁC API_KEY.
# Để trống = tắt lưu token (endpoint trả 503), app vẫn khởi động.
# MẤT KHOÁ = phải nhập lại mọi token.
# Sinh khoá: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_SECRET_KEY=
# [TUỲ CHỌN] Khoá cũ khi xoay khoá (phân cách dấu phẩy), chỉ dùng để giải mã.
# Bỏ trống nếu không xoay.
INTEGRATION_SECRET_KEY_OLD=

# Host bổ sung cho allowlist URL đồng bộ (ngoài Google Docs/Sheets/Drive,
# SharePoint, OneDrive). Phân cách dấu phẩy, chỉ https; `host` khớp chính xác,
# `*.host` khớp mọi tên miền con. Không nhận IP hay `*.com`. Sai cú pháp thì
# core không khởi động. Áp dụng cho CẢ core và web (cùng một biến).
SYNC_URL_EXTRA_HOSTS=

# Số ngày giữ task đã xoá trong thùng rác trước khi xoá vĩnh viễn.
# Đặt 0 nghĩa là xoá thẳng, không qua thùng rác.
TRASH_RETENTION_DAYS=30

# Giới hạn request mỗi phút ở Redis, đếm theo user (JWT), rồi X-API-Key, rồi IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=300

# ── Đăng nhập & phân quyền (core + web) ────────────────────────
# Email luôn là admin (phân cách dấu phẩy). Core upsert lúc khởi động và UI
# không hạ/khoá được: đường "phá kính" khi lỡ khoá hết admin.
# smoke-test.sh cũng lấy email đầu tiên ở đây làm SMOKE_EMAIL.
ADMIN_EMAILS=

# Domain Google Workspace được phép đăng nhập (phân cách dấu phẩy).
# Rỗng = mọi tài khoản đã được mời. Web và core cùng kiểm.
GOOGLE_ALLOWED_HD=

# Công tắc khẩn cấp đăng nhập bằng mật khẩu (tài khoản nội bộ). false = 403
# `password_login_disabled`; dùng khi bị brute-force. Không ảnh hưởng Google/CLI/admin API.
PASSWORD_LOGIN_ENABLED=true

# ── Web (Next.js + Auth.js) ────────────────────────────────────
WEB_PORT=3000
# URL nội bộ trong docker network, web gọi api qua service name
CORE_API_URL=http://api:8000

# Nguồn dữ liệu của web. Giá trị hợp lệ: api | file | memory.
#   api     Postgres qua core API — chế độ thật, giữ nguyên khi deploy thật.
#   file    Ghi vào ./data/builder-data.json trên host, không cần Postgres.
#           Dùng khi muốn demo nhanh mà chưa dựng được api/postgres.
#   memory  Dữ liệu mẫu trong RAM, mất khi container restart. Chỉ để xem UI.
# Đổi giá trị này cần "docker compose up -d web" lại để nhận .env mới.
# Trên production (docker-compose.prod.yml) chỉ nên dùng "api".
DATA_SOURCE=api

# Bắt buộc khi DATA_SOURCE=api; thiếu thì web hiện trang lỗi cấu hình thay vì
# mở cửa. Hướng dẫn tạo OAuth client: docs/GOOGLE_OAUTH_SETUP.md
# Sinh AUTH_SECRET: openssl rand -base64 32 (khác API_KEY và CORE_JWT_SECRET)
AUTH_SECRET=
# URL công khai của web (đúng với redirect URI đã khai ở Google).
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Chỉ đặt true khi có reverse proxy ghi đè X-Forwarded-For; nếu không client
# tự đặt IP để né giới hạn đăng nhập.
TRUST_FORWARDED_FOR=false
# Số proxy tin cậy đứng trước web (Caddy = 1), lấy IP client từ bên phải
# X-Forwarded-For theo số hop này.
TRUSTED_PROXY_HOPS=1

# ═══════════════════════════════════════════════════════════════
#  Profile: llm   →  docker compose --profile llm up -d
# ═══════════════════════════════════════════════════════════════
LITELLM_PORT=4000
# Master key phải bắt đầu bằng "sk-"
LITELLM_MASTER_KEY=sk-CHANGE_ME
# Dùng để mã hoá credential trong DB. Đổi key này là mất toàn bộ key đã lưu.
LITELLM_SALT_KEY=CHANGE_ME

# API key của provider. Lưu ý: gói Claude Pro / ChatGPT Plus KHÔNG cấp
# quyền API. Lấy key riêng tại console.anthropic.com / platform.openai.com.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini có free tier tại aistudio.google.com/apikey
GEMINI_API_KEY=

# Local model qua Ollama chạy trên host
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ═══════════════════════════════════════════════════════════════
#  Profile: monitoring  →  docker compose --profile monitoring up -d
# ═══════════════════════════════════════════════════════════════
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
BLACKBOX_PORT=9115

# ═══════════════════════════════════════════════════════════════
#  Chỉ cho `make smoke` (scripts/smoke-test.sh) — tuỳ chọn
# ═══════════════════════════════════════════════════════════════
# Mặc định lấy email đầu tiên trong ADMIN_EMAILS. Đặt khi muốn ghi đè.
# SMOKE_EMAIL=
# User thứ hai (nếu có) để kiểm cô lập task cá nhân.
# SMOKE_EMAIL_2=
